#vim:filetype=i3

set $mod Mod4

# Floating Windows
floating_modifier $mod
bindsym $mod+Shift+space floating toggle

# Toggle horizontal/vertical split
bindsym $mod+t split toggle

# General Window Manipulation
bindsym $mod+q kill

bindsym $mod+f fullscreen

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Resizing
bindsym $mod+Ctrl+h resize grow left 5 px
bindsym $mod+Ctrl+j resize grow down  5 px
bindsym $mod+Ctrl+k resize grow up    5 px
bindsym $mod+Ctrl+l resize grow right 5 px

# Workspaces
exec $HOME/bin/sway_change_workspaces 0

bindsym $mod+1 exec $HOME/bin/sway_switch_focused_workspace 0
bindsym $mod+2 exec $HOME/bin/sway_switch_focused_workspace 1
bindsym $mod+3 exec $HOME/bin/sway_switch_focused_workspace 2
bindsym $mod+4 exec $HOME/bin/sway_switch_focused_workspace 3
bindsym $mod+5 exec $HOME/bin/sway_switch_focused_workspace 4

bindsym $mod+Ctrl+1 exec $HOME/bin/sway_change_workspaces 0
bindsym $mod+Ctrl+2 exec $HOME/bin/sway_change_workspaces 1
bindsym $mod+Ctrl+3 exec $HOME/bin/sway_change_workspaces 2
bindsym $mod+Ctrl+4 exec $HOME/bin/sway_change_workspaces 3
bindsym $mod+Ctrl+5 exec $HOME/bin/sway_change_workspaces 4

bindsym $mod+Shift+1 exec $HOME/bin/sway_move_focused_window 0
bindsym $mod+Shift+2 exec $HOME/bin/sway_move_focused_window 1
bindsym $mod+Shift+3 exec $HOME/bin/sway_move_focused_window 2
bindsym $mod+Shift+4 exec $HOME/bin/sway_move_focused_window 3
bindsym $mod+Shift+5 exec $HOME/bin/sway_move_focused_window 4

# Bind screenshot and screenrecord
bindsym --release Print exec grim -g "$(slurp)" ~/pictures/tmp.png
bindsym --release $mod+Print exec bash -c 'pkill wf-recorder || wf-recorder -x yuvj420p -g "$(slurp)" -yf ~/pictures/tmp.mp4'

# Terminal
bindsym $mod+Return exec alacritty msg create-window || alacritty

# Browser
bindsym $mod+b exec firefox

# Floating Presets
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [class="float-test"] floating enable

# Gaps
gaps inner 15

# Borders
default_border none
default_floating_border none

# Misc
workspace_auto_back_and_forth no
force_display_urgency_hint 0 ms
focus_on_window_activation urgent

# Outputs
output DP-1 mode 2560x1440@144Hz pos 5120 0 bg ~/pictures/wallpapers/revenant.jpg stretch
output DP-2 mode 2560x1440@144Hz pos 0 0 bg ~/pictures/wallpapers/revenant.jpg stretch
output DP-3 mode 2560x1440@144Hz pos 2560 0 bg ~/pictures/wallpapers/revenant.jpg stretch

# Input configuration
input "*" accel_profile flat
input type:keyboard xkb_options compose:ralt

# Bar
exec bash -c "while true; do stele_undead DP-1; sleep 1; done"
exec bash -c "while true; do stele_undead DP-2; sleep 1; done"
exec bash -c "while true; do stele_undead DP-3; sleep 1; done"
